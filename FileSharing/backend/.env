# App Configuration
APP_NAME=FileShareSystem
APP_ENV=development
DEBUG=True
SECRET_KEY=yoursecretkey_changeme_in_production

# Database Configuration (Postgres)
# Connects to the shared 'postgres' container started by ToolHub/Database/
# Credentials MUST match ToolHub/Database/docker-compose.database.yml
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=filesharingsystem
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://user:password@postgres:5432/filesharingsystem

# Local File Storage (inside the container)
UPLOAD_DIR=./uploads

# Public URL for share links (so they're reachable from other devices)
# Nginx will be the entry point — set to the machine's LAN IP or public domain.
# Share links will use /fileshare/d/<filename>?token=...
# Leave empty to auto-detect from the incoming request.
PUBLIC_BASE_URL=
